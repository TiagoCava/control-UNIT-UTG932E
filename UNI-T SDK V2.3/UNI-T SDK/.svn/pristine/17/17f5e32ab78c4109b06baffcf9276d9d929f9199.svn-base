        <member name="M:uci.UCIInterop.Read(System.UInt32,uci.RParams@,System.Byte[],System.UInt32)">
            <summary>
            读参数。请使用<see cref="M:uci.UCIInterop.ReadX(System.UInt32,System.String,System.UInt32,System.Byte[],System.UInt32)"/>
            </summary>
            <param name="_session">会话ID，由<see cref="M:uci.UCIInterop.Open(System.String,System.UInt32@,System.UInt32)"/>获得</param>
