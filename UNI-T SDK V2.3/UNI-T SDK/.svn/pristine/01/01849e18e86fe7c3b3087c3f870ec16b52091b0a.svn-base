            <summary>
            查询在线的设备（建议不再使用该接口，可用<see cref="M:uci.UCIInterop.QueryNodesX(System.String,uci.Node[],System.Int32,System.UInt32)"/>代替）
            </summary>
            <param name="param">查询参数</param>
            <param name="n">输出设备信息的缓冲区</param>
