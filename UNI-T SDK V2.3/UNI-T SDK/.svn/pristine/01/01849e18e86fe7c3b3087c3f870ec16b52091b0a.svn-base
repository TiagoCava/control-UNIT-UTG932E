        <member name="M:uci.UCIInterop.FindUnitTypeName(System.Char)">
            <summary>
            获取单位类型编码对应的单位名
            </summary>
            <param name="_code">单位类型编码，编码定义见<seealso cref="T:uci.Model.unit.Type"/></param>
            <returns>单位名</returns>
        </member>
        <member name="M:uci.UCIInterop.UnitRefresh(System.Double,uci.Model.unit.Scale,System.Double)">
            <summary>
            将当前单位的数值自动转换到合适的单位类型，以使数值小于进制。比如2300Hz，转换后就是2.3kHzs
            </summary>
            <param name="_value">当前值</param>
            <param name="_unit_code">当前单位编码</param>
            <param name="_scale">进制，一般为1000，比如频率的进制是1000</param>
            <returns></returns>
        </member>
        <member name="M:uci.UCIInterop.UnitConvertTo(System.Double,System.Int32,System.Int32,System.Double)">
            <summary>
            将当前单位的数值转换到指定的单位。
            </summary>
            <param name="_cur_value">当前数值</param>
            <param name="_cur_unit">当前单位编码</param>
            <param name="_des_unit">要转换到的单位编码</param>
            <param name="_scale">进制，一般为1000，比如频率的进制是1000</param>
            <returns>返回转换后的数值，比如2.3KHz 转换为Hz就是2300Hz</returns>
            <remarks>注意单位编码必须如EScale定义的，连续递增的量。</remarks>
        </member>
        <member name="M:uci.UCIInterop.GetUnitTypeName(System.Char)">
            <summary>
            获取单位类型编码对应的单位名
            </summary>
            <param name="_code">单位类型编码，编码定义见<seealso cref="T:uci.Model.unit.Type"/></param>
            <returns>单位名</returns>
        </member>
